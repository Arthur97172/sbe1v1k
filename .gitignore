# 仓库只保存编译输入：24.10-6.6/、25.12-6.12/ 与对应的 workflow。
# 以下内容只在本机存在，不进 git。

# 装配源码树与构建产物（约 24 GB）
/sources/
/dist/
/firmware/
/extracted/
/logs/
/build/

# 本机审计与测试资料
/scripts/
/docs/
/files/
/banner
/99-wireless-defaults
/README.md
/CLAUDE.md
/CLAUDE_BUILD_GUIDE.md
/.claude/

# 宿主机垫片软链由脚本按清单重建（本机指向 /usr/bin/gnu*，runner 上没有）
/24.10-6.6/build/host-bin/
/25.12-6.12/build/host-bin/

# Stage 2.5：厂商专有 Wi-Fi 固件 blob 不进 git（LICENSE_REVIEW_REQUIRED，N-3）。
# 由私有 Release `fw-v1` 分发，scripts/ci/fetch-wifi-blobs.sh 取回并校验；
# Makefile / FILES-SHA256 / LICENSE-STATUS 仍然入库。
/25.12-6.12/build/local-packages/sbe-wifi-firmware/files/**/*.bin

# 签名材料与备份
key-build
key-build.*
*.ucert
*.bak
*.log
