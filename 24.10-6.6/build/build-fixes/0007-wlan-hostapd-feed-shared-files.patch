+#
+# Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+# SPDX-License-Identifier: ISC
+#
+# wpa_supplicant configuration for 802.1X wired authentication
+# Reference configuration for RGW WAN interface
+#
+# Deploy to: /etc/802.1x/wpa-wired-reference.conf (reference only)
+# Usage: Copy and modify for your deployment
+#
+# For detailed configuration options, see:
+# https://w1.fi/cgit/hostap/plain/wpa_supplicant/wpa_supplicant.conf
+
+# ============================================================================
+# Global Configuration
+# ============================================================================
+
+# Control interface for wpa_cli
+# Required for event monitoring and status queries
+ctrl_interface=/var/run/wpa_supplicant
+
+# Disable Wi-Fi scanning (wired mode)
+# Required for wired 802.1X
+ap_scan=0
+
+# EAPOL protocol version
+# 3 = IEEE 802.1X-2010 (recommended for QSDK MACsec builds)
+eapol_version=3
+
+# ============================================================================
+# Network Profile: EAP-TLS (Certificate-based Authentication)
+# ============================================================================
+
+network={
+    # Key management: IEEE 802.1X
+    key_mgmt=IEEE8021X
+
+    # EAP method: TLS (mutual authentication with certificates)
+    eap=TLS
+
+    # Identity sent in EAP-Response/Identity
+    # This should match the CN or subjectAltName in your client certificate
+    identity="client-001"
+
+    # Certificate paths
+    # Ensure these files exist and have correct permissions
+    ca_cert="/etc/certs/ca.pem"                    # Root CA certificate
+    client_cert="/etc/certs/client.pem"            # Client certificate
+    private_key="/etc/certs/client.key.dec"        # Client private key (decrypted)
+
+    # Private key password (if key is encrypted)
+    # Leave empty if using decrypted key
+    private_key_passwd=""
+
+    # EAPOL flags
+    # 0 = default behavior
+    eapol_flags=0
+
+    # MACsec policy
+    # 0 = MACsec disabled (plain 802.1X authentication only)
+    # 1 = MACsec optional (use if available)
+    macsec_policy=0
+
+    # Priority (for multi-profile scenarios)
+    # Higher number = higher priority
+    # priority=100
+
+    # Profile identifier (optional, for logging)
+    # id_str="primary_tls"
+}
+
+# ============================================================================
+# Network Profile: EAP-MD5 (Username/Password Authentication)
+# ============================================================================
+# Uncomment to enable EAP-MD5 profile
+
+# network={
+#     key_mgmt=IEEE8021X
+#     eap=MD5
+#
+#     # Username
+#     identity="operator_user"
+#
+#     # Password (plaintext)
+#     password="secret_password"
+#
+#     eapol_flags=0
+#     macsec_policy=0
+#
+#     # Lower priority than TLS
+#     priority=50
+#
+#     id_str="fallback_md5"
+# }
+
+# ============================================================================
+# Multi-Profile Example (Priority-based Selection)
+# ============================================================================
+# When multiple profiles are defined, wpa_supplicant will try them in order
+# of priority (highest first). This is useful for:
+# - Primary/backup authentication methods
+# - Different credentials for different networks
+# - Graceful fallback scenarios
+
+# Example: 3 profiles with different priorities
+# network={
+#     id_str="profile_1_tls_primary"
+#     priority=100
+#     key_mgmt=IEEE8021X
+#     eap=TLS
+#     identity="client-001"
+#     ca_cert="/etc/certs/ca.pem"
+#     client_cert="/etc/certs/client.pem"
+#     private_key="/etc/certs/client.key.dec"
+#     eapol_flags=0
+#     macsec_policy=0
+# }
+#
+# network={
+#     id_str="profile_2_tls_backup"
+#     priority=90
+#     key_mgmt=IEEE8021X
+#     eap=TLS
+#     identity="client-002"
+#     ca_cert="/etc/certs/ca_backup.pem"
+#     client_cert="/etc/certs/client_backup.pem"
+#     private_key="/etc/certs/client_backup.key.dec"
+#     eapol_flags=0
+#     macsec_policy=0
+# }
+#
+# network={
+#     id_str="profile_3_md5_fallback"
+#     priority=50
+#     key_mgmt=IEEE8021X
+#     eap=MD5
+#     identity="fallback_user"
+#     password="fallback_pass"
+#     eapol_flags=0
+#     macsec_policy=0
+# }
+
+# ============================================================================
+# Advanced Options (Uncomment if needed)
+# ============================================================================
+
+# Fast re-authentication
+# fast_reauth=1
+
+# Update configuration file on changes
+# update_config=0
+
+# Country code (for regulatory compliance)
+# country=US
+
+# ============================================================================
+# Deployment Notes
+# ============================================================================
+
+# 1. Certificate Preparation:
+#    - Generate or obtain CA certificate, client certificate, and private key
+#    - Decrypt private key if encrypted:
+#      openssl rsa -in client.key -out client.key.dec
+#    - Deploy to /etc/certs/ with correct permissions:
+#      chmod 644 /etc/certs/ca.pem
+#      chmod 644 /etc/certs/client.pem
+#      chmod 600 /etc/certs/client.key.dec
+
+# 2. Configuration Deployment:
+#    - Copy this file to /tmp/wpa-tls.conf (or your preferred location)
+#    - Modify identity and certificate paths as needed
+#    - Ensure ctrl_interface directory exists:
+#      mkdir -p /var/run/wpa_supplicant
+
+# 3. Testing:
+#    - Start with debug output:
+#      8021x-client start -i eth0 -c /tmp/wpa-tls.conf -- -dd
+#    - Monitor logs (syslog):
+#      logread -f | grep -E "wpa_supplicant|8021x_action|8021x-client"
+#    - Check status:
+#      8021x-client status -i eth0
+
+# 4. Production Deployment:
+#    - Remove debug flags
+#    - Integrate with system init (netifd/systemd)
+#    - Set up certificate renewal procedures
+#    - Configure monitoring and alerting
+
+# ============================================================================
+# Security Considerations
+# ============================================================================
+
+# - Store private keys with restrictive permissions (600)
+# - Use encrypted private keys in production (with secure password storage)
+# - Implement certificate expiration monitoring
+# - Rotate certificates regularly
+# - Use strong CA and client certificates (RSA 2048+ or ECC)
+# - Validate server certificates (ca_cert must be configured)
+# - Avoid storing passwords in plaintext (use encrypted keys instead)
+
+# ============================================================================
+# Troubleshooting
+# ============================================================================
+
+# Common issues:
+# 1. "EAP authentication failed" - Check certificate validity and paths
+# 2. "suppPortStatus=Unauthorized" - Authenticator may not trust your CA
+# 3. "Connection timeout" - Check network connectivity and EAPOL forwarding
+# 4. "Private key decryption failed" - Verify private_key_passwd or use decrypted key
+# 5. "Certificate expired" - Check certificate validity dates with:
+#    openssl x509 -in /etc/certs/client.pem -noout -dates
+
+# For troubleshooting, check syslog (logread) and validate cert paths/permissions.
+
diff -ruN a/qca/feeds/wlan-hostapd/hostapd/files/wps-hotplug.sh b/qca/feeds/wlan-hostapd/hostapd/files/wps-hotplug.sh
--- a/qca/feeds/wlan-hostapd/hostapd/files/wps-hotplug.sh	1970-01-01 00:00:00.000000000 +0000
