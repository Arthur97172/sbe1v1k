+				for (let mon in mon_if_names) {
+					ret = system(`ifconfig ${mon} up`);
+
+					if (ret) {
+						hostapd.printf(`Failed to bring up monitor interface ${mon}: ${ret}`);
+						continue;
+					}
+					if (freq_info.frequency == freq_info.center_freq1)
