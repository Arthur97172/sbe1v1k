From: SBE1V1K build <noreply@example.invalid>
Subject: [PATCH] nss_dp_ethtools: port EEE and get_ts_info to the 6.9+/6.11+ API

Linux 6.9 moved the .get_eee/.set_eee ethtool ops from the uapi struct
ethtool_eee (u32 bitmasks) to struct ethtool_keee (link-mode bitmaps),
and Linux 6.11 moved .get_ts_info from struct ethtool_ts_info to struct
kernel_ethtool_ts_info.  Both old signatures now fail to build with
-Wincompatible-pointer-types (and -Werror):

nss_dp_ethtools.c:419:44: error: passing argument 2 of 'ethtool_op_get_ts_info'
  from incompatible pointer type
nss_dp_ethtools.c:615:20: error: initialization of
  'int (*)(struct net_device *, struct ethtool_keee *)' from incompatible
  pointer type 'int32_t (*)(struct net_device *, struct ethtool_eee *)'
nss_dp_ethtools.c:616:20: (same for .set_eee)
nss_dp_ethtools.c:619:24: error: initialization of
  'int (*)(struct net_device *, struct kernel_ethtool_ts_info *)' from
  incompatible pointer type 'int (*)(struct net_device *, struct ethtool_ts_info *)'

Classification: mainline-replaces-API.

EEE: the FAL-to-ethtool translation now writes into a link-mode bitmap
with linkmode_set_bit() instead of OR-ing SUPPORTED_* into a u32; the
bit numbering is identical (both follow the legacy ADVERTISED_* order),
so the mapping itself is unchanged.  set_eee walks the bitmap with
for_each_set_bit() over __ETHTOOL_LINK_MODE_MASK_NBITS instead of
ffs()ing a u32, and tests an empty mask with linkmode_empty().

get_ts_info: the HAL (nss_dp_hal_if.h, syn_if.c, syn_ptp.c) keeps filling
the uapi struct ethtool_ts_info, so the ethtool op wrapper converts at the
boundary.  The five fields the core copies through (cmd, so_timestamping,
phc_index, tx_types, rx_filters) exist in both structs with the same
meaning, so the conversion is lossless.
--- a/nss_dp_ethtools.c
+++ b/nss_dp_ethtools.c
@@ -207,7 +207,7 @@
  * nss_dp_fal_to_ethtool_linkmode_xlate()
  *	Translate linkmode from FAL type to ethtool type.
  */
-static inline void nss_dp_fal_to_ethtool_linkmode_xlate(uint32_t *xlate_to, uint32_t *xlate_from)
+static inline void nss_dp_fal_to_ethtool_linkmode_xlate(unsigned long *xlate_to, uint32_t *xlate_from)
 {
 	uint32_t pos;
 
@@ -215,19 +215,19 @@
 		pos = ffs(*xlate_from);
 		switch (1 << (pos - 1)) {
 		case FAL_PHY_EEE_10BASE_T:
-			*xlate_to |= SUPPORTED_10baseT_Full;
+			linkmode_set_bit(ETHTOOL_LINK_MODE_10baseT_Full_BIT, xlate_to);
 			break;
 
 		case FAL_PHY_EEE_100BASE_T:
-			*xlate_to |= SUPPORTED_100baseT_Full;
+			linkmode_set_bit(ETHTOOL_LINK_MODE_100baseT_Full_BIT, xlate_to);
 			break;
 
 		case FAL_PHY_EEE_1000BASE_T:
-			*xlate_to |= SUPPORTED_1000baseT_Full;
+			linkmode_set_bit(ETHTOOL_LINK_MODE_1000baseT_Full_BIT, xlate_to);
 			break;
 
 		case FAL_PHY_EEE_2500BASE_T:
-			*xlate_to |= SUPPORTED_2500baseX_Full;
+			linkmode_set_bit(ETHTOOL_LINK_MODE_2500baseX_Full_BIT, xlate_to);
 			break;
 
 		case FAL_PHY_EEE_5000BASE_T:
@@ -237,7 +237,7 @@
 			break;
 
 		case FAL_PHY_EEE_10000BASE_T:
-			*xlate_to |= SUPPORTED_10000baseT_Full;
+			linkmode_set_bit(ETHTOOL_LINK_MODE_10000baseT_Full_BIT, xlate_to);
 			break;
 		}
 
@@ -249,7 +249,7 @@
  * nss_dp_get_eee()
  *	Get EEE settings.
  */
-static int32_t nss_dp_get_eee(struct net_device *netdev, struct ethtool_eee *eee)
+static int32_t nss_dp_get_eee(struct net_device *netdev, struct ethtool_keee *eee)
 {
 	struct nss_dp_dev *dp_priv = (struct nss_dp_dev *)netdev_priv(netdev);
 	fal_port_eee_cfg_t port_eee_cfg;
@@ -267,9 +267,9 @@
 	/*
 	 * Translate the FAL linkmode types to ethtool linkmode types.
 	 */
-	nss_dp_fal_to_ethtool_linkmode_xlate(&eee->supported, &port_eee_cfg.capability);
-	nss_dp_fal_to_ethtool_linkmode_xlate(&eee->advertised, &port_eee_cfg.advertisement);
-	nss_dp_fal_to_ethtool_linkmode_xlate(&eee->lp_advertised, &port_eee_cfg.link_partner_advertisement);
+	nss_dp_fal_to_ethtool_linkmode_xlate(eee->supported, &port_eee_cfg.capability);
+	nss_dp_fal_to_ethtool_linkmode_xlate(eee->advertised, &port_eee_cfg.advertisement);
+	nss_dp_fal_to_ethtool_linkmode_xlate(eee->lp_advertised, &port_eee_cfg.link_partner_advertisement);
 	eee->eee_enabled = port_eee_cfg.enable;
 	eee->eee_active = port_eee_cfg.eee_status;
 	eee->tx_lpi_enabled = port_eee_cfg.lpi_tx_enable;
@@ -282,7 +282,7 @@
  * nss_dp_set_eee()
  *	Set EEE settings.
  */
-static int32_t nss_dp_set_eee(struct net_device *netdev, struct ethtool_eee *eee)
+static int32_t nss_dp_set_eee(struct net_device *netdev, struct ethtool_keee *eee)
 {
 	struct nss_dp_dev *dp_priv = (struct nss_dp_dev *)netdev_priv(netdev);
 	fal_port_eee_cfg_t port_eee_cfg, port_eee_cur_cfg;
@@ -309,16 +309,15 @@
 	 * supported modes. This matches the behaviour of other drivers
 	 * when ethtool is called with just "eee on" and no advertise mask.
 	 */
-	if (!eee->advertised && eee->eee_enabled) {
+	if (linkmode_empty(eee->advertised) && eee->eee_enabled) {
 		port_eee_cfg.advertisement = port_eee_cur_cfg.capability;
 	} else {
 		/*
 		 * Translate the ethtool speed types to FAL speed types.
 		 */
-		while (eee->advertised) {
-			pos = ffs(eee->advertised);
-			switch (1 << (pos - 1)) {
-			case ADVERTISED_10baseT_Full:
+		for_each_set_bit(pos, eee->advertised, __ETHTOOL_LINK_MODE_MASK_NBITS) {
+			switch (pos) {
+			case ETHTOOL_LINK_MODE_10baseT_Full_BIT:
 				if (port_eee_cur_cfg.capability & FAL_PHY_EEE_10BASE_T) {
 					port_eee_cfg.advertisement |= FAL_PHY_EEE_10BASE_T;
 					break;
@@ -327,7 +326,7 @@
 				netdev_dbg(netdev, "Advertised value 10baseT_Full is not supported\n");
 				return -EIO;
 
-			case ADVERTISED_100baseT_Full:
+			case ETHTOOL_LINK_MODE_100baseT_Full_BIT:
 				if (port_eee_cur_cfg.capability & FAL_PHY_EEE_100BASE_T) {
 					port_eee_cfg.advertisement |= FAL_PHY_EEE_100BASE_T;
 					break;
@@ -336,7 +335,7 @@
 				netdev_dbg(netdev, "Advertised value 100baseT_Full is not supported\n");
 				return -EIO;
 
-			case ADVERTISED_1000baseT_Full:
+			case ETHTOOL_LINK_MODE_1000baseT_Full_BIT:
 				if (port_eee_cur_cfg.capability & FAL_PHY_EEE_1000BASE_T) {
 					port_eee_cfg.advertisement |= FAL_PHY_EEE_1000BASE_T;
 					break;
@@ -345,7 +344,7 @@
 				netdev_dbg(netdev, "Advertised value 1000baseT_Full is not supported\n");
 				return -EIO;
 
-			case ADVERTISED_2500baseX_Full:
+			case ETHTOOL_LINK_MODE_2500baseX_Full_BIT:
 				if (port_eee_cur_cfg.capability & FAL_PHY_EEE_2500BASE_T) {
 					port_eee_cfg.advertisement |= FAL_PHY_EEE_2500BASE_T;
 					break;
@@ -354,7 +353,7 @@
 				netdev_dbg(netdev, "Advertised value 2500baseX_Full is not supported\n");
 				return -EIO;
 
-			case ADVERTISED_10000baseT_Full:
+			case ETHTOOL_LINK_MODE_10000baseT_Full_BIT:
 				if (port_eee_cur_cfg.capability & FAL_PHY_EEE_10000BASE_T) {
 					port_eee_cfg.advertisement |= FAL_PHY_EEE_10000BASE_T;
 					break;
@@ -367,8 +366,6 @@
 				netdev_dbg(netdev, "Advertised value is not supported\n");
 				return -EIO;
 			}
-
-			eee->advertised &= (~(1 << (pos - 1)));
 		}
 	}
 
@@ -406,13 +403,30 @@
  * nss_dp_get_ts_info()
  *	Get PTP timestamping information
  */
-static int nss_dp_get_ts_info(struct net_device *dev, struct ethtool_ts_info *info)
+static int nss_dp_get_ts_info(struct net_device *dev, struct kernel_ethtool_ts_info *info)
 {
 	struct nss_dp_dev *dp_priv = (struct nss_dp_dev *)netdev_priv(dev);
+	struct ethtool_ts_info ts_info = {};
+	int32_t ret;
 
 	/* Check if HAL supports get_ts_info operation */
 	if (dp_priv->gmac_hal_ops && dp_priv->gmac_hal_ops->get_ts_info) {
-		return dp_priv->gmac_hal_ops->get_ts_info(dp_priv->gmac_hal_ctx, info);
+		/*
+		 * The HAL and the Synopsys PTP code still fill the uapi
+		 * struct ethtool_ts_info; copy the result into the kernel
+		 * struct the ethtool core expects from .get_ts_info.
+		 */
+		ret = dp_priv->gmac_hal_ops->get_ts_info(dp_priv->gmac_hal_ctx, &ts_info);
+		if (ret)
+			return ret;
+
+		info->cmd = ts_info.cmd;
+		info->so_timestamping = ts_info.so_timestamping;
+		info->phc_index = ts_info.phc_index;
+		info->tx_types = ts_info.tx_types;
+		info->rx_filters = ts_info.rx_filters;
+
+		return 0;
 	}
 
 	/* Fall back to default ethtool implementation */
