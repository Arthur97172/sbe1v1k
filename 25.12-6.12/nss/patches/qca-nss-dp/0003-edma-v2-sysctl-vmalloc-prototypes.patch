-int edma_vlan_append_handler(struct ctl_table *table, int write, void __user *buffer, size_t *lenp, loff_t *ppos);
-int edma_force_crash_handler(struct ctl_table *table, int write, void __user *buffer, size_t *lenp, loff_t *ppos);
+int edma_hang_recovery_handler(const struct ctl_table *table, int write, void __user *buffer, size_t *lenp, loff_t *ppos);
+int edma_vlan_append_handler(const struct ctl_table *table, int write, void __user *buffer, size_t *lenp, loff_t *ppos);
