+static bool ppe_drv_flow_v4_service_code_get(struct ppe_drv_v4_conn_flow *pcf, struct ppe_drv_port *pp, uint8_t *scp)
 {
 	struct ppe_drv *p __maybe_unused = ppe_drv_gbl;
