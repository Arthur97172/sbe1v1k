diff -ruN a/drv/ppe_drv/ppe_drv.h b/drv/ppe_drv/ppe_drv.h
--- a/drv/ppe_drv/ppe_drv.h
+++ b/drv/ppe_drv/ppe_drv.h
@@ -61,6 +61,20 @@
 #include <linux/netdevice.h>
 #endif
 
+/*
+ * QSDK extends struct net_device with a priv_flags_ext word and marks
+ * MAP-T interfaces with IFF_EXT_MAPT.  Mainline 6.12 has neither, and the
+ * MAP-T client (qca-nss-ppe-mapt) is not part of this port, so no
+ * interface can ever carry the flag and the test is always false.  This
+ * keeps the port's behaviour identical to a QSDK build without MAP-T.
+ * If MAP-T support is added later, this must become a real flag on the
+ * mainline net_device rather than a constant.
+ */
+static inline bool ppe_drv_dev_is_mapt(const struct net_device *dev)
+{
+	return false;
+}
+
 extern uint32_t static_dbg_level;
 extern bool flow_deacclr_dis;
 extern int mac_lrn_exception_en;
diff -ruN a/drv/ppe_drv/tun/ppe_drv_tun_v6.c b/drv/ppe_drv/tun/ppe_drv_tun_v6.c
--- a/drv/ppe_drv/tun/ppe_drv_tun_v6.c
+++ b/drv/ppe_drv/tun/ppe_drv_tun_v6.c
@@ -281,7 +281,7 @@
 	/*
 	 * Check if the rule is for MAP-T
 	 */
-	if (dev->priv_flags_ext & IFF_EXT_MAPT) {
+	if (ppe_drv_dev_is_mapt(dev)) {
 		spin_unlock_bh(&p->lock);
 		return true;
 	}
