From: SBE1V1K build <noreply@example.invalid>
Subject: [PATCH] nss-ppe: v4 linkage and multicast prototypes

  three *_conn_fill helpers   only called from ppe_drv_v4.c, defined
                              before the call sites -> static.
  three ppe_drv_v4_mc_*       no in-tree caller here, but the vendor ABI
                              keeps them external for the multicast
                              client -> declare them in ppe_drv_v4.h.

diff -ruN a/drv/ppe_drv/ppe_drv_v4.c b/drv/ppe_drv/ppe_drv_v4.c
--- a/drv/ppe_drv/ppe_drv_v4.c
+++ b/drv/ppe_drv/ppe_drv_v4.c
@@ -376,7 +376,7 @@
  * ppe_drv_v4_rfs_conn_fill()
  *	Populate single direction flow object rule.
  */
-ppe_drv_ret_t ppe_drv_v4_rfs_conn_fill(struct ppe_drv_v4_rule_create *create, struct ppe_drv_top_if_rule *top_if,
+static ppe_drv_ret_t ppe_drv_v4_rfs_conn_fill(struct ppe_drv_v4_rule_create *create, struct ppe_drv_top_if_rule *top_if,
 				       struct ppe_drv_v4_conn *cn, enum ppe_drv_conn_type flow_type, bool ppe_iface_chk_needed)
 {
 	struct ppe_drv_v4_connection_rule *conn = &create->conn_rule;
@@ -573,7 +573,7 @@
  * ppe_drv_v4_policer_conn_fill()
  *	Populate single direction flow object rule.
  */
-ppe_drv_ret_t ppe_drv_v4_policer_conn_fill(struct ppe_drv_v4_rule_create *create, struct ppe_drv_top_if_rule *top_if,
+static ppe_drv_ret_t ppe_drv_v4_policer_conn_fill(struct ppe_drv_v4_rule_create *create, struct ppe_drv_top_if_rule *top_if,
 				       struct ppe_drv_v4_conn *cn, enum ppe_drv_conn_type flow_type)
 {
 	struct ppe_drv_v4_connection_rule *conn = &create->conn_rule;
@@ -733,7 +733,7 @@
  * ppe_drv_v4_priority_conn_fill()
  * 	Populate single direction flow object rule.
  */
-ppe_drv_ret_t ppe_drv_v4_priority_conn_fill(struct ppe_drv_v4_rule_create *create, struct ppe_drv_v4_conn *cn,
+static ppe_drv_ret_t ppe_drv_v4_priority_conn_fill(struct ppe_drv_v4_rule_create *create, struct ppe_drv_v4_conn *cn,
 						enum ppe_drv_conn_type flow_type)
 {
 	struct ppe_drv_v4_connection_rule *conn = &create->conn_rule;
diff -ruN a/drv/ppe_drv/ppe_drv_v4.h b/drv/ppe_drv/ppe_drv_v4.h
--- a/drv/ppe_drv/ppe_drv_v4.h
+++ b/drv/ppe_drv/ppe_drv_v4.h
@@ -998,3 +998,11 @@
 		struct hlist_head *head_tbl, bool ignore_rule_id);
 struct ppe_drv_flow *ppe_drv_v4_flow_hash_tuple_find_by_dev(struct ppe_drv_v4_5tuple *tuple,
 		struct hlist_head *head_tbl, struct net_device *dev);
+
+/*
+ * Multicast rule entry points.  No in-tree caller in this build profile,
+ * but the vendor ABI keeps them external for the multicast client.
+ */
+ppe_drv_ret_t ppe_drv_v4_mc_create(struct ppe_drv_v4_rule_create *create);
+ppe_drv_ret_t ppe_drv_v4_mc_update(struct ppe_drv_v4_rule_create *update);
+ppe_drv_ret_t ppe_drv_v4_mc_destroy(struct ppe_drv_v4_rule_destroy *destroy);
