-bool ppe_drv_tun_port_reset_physical_port(struct ppe_drv_port *pp)
+static bool ppe_drv_tun_port_reset_physical_port(struct ppe_drv_port *pp)
 {
 	sw_error_t err;
 	uint32_t v_port = FAL_PORT_ID(FAL_PORT_TYPE_VPORT, pp->port);
@@ -477,7 +500,7 @@
