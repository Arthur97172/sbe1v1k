+static bool ppe_drv_tun_port_encap_disable(struct ppe_drv_port *pp)
 {
 	sw_error_t err;
 	fal_vport_state_t vp_state = {0};
@@ -459,7 +482,7 @@
  * ppe_drv_tun_port_deconfigure
  * 	Deconfigure tunnel specific configuration in port
