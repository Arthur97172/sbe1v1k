  * 	Get base port associated with the xmit port
  */
-uint8_t ppe_drv_tun_xmit_port_get(uint8_t xmit_port)
+static uint8_t ppe_drv_tun_xmit_port_get(uint8_t xmit_port)
 {
 	struct ppe_drv *p = ppe_drv_gbl;
 
