From: SBE1V1K build <noreply@example.invalid>
Subject: [PATCH] nss-ppe: tun file-local helpers and nat46 xlate shim

  eight helpers        used only inside ppe_drv_tun.c, defined before the
                       call sites, none exported -> static.
  xlate_4_to_6/6_to_4  QSDK's nat46 (2022-09-19) exports these for the
                       MAP-T data path; OpenWrt 25.12 ships nat46
                       2025-04-23, which no longer has the API.  The
                       port already treats MAP-T as absent (dev_is_mapt()
                       is false and the mapt client is not built), so the
                       lookup answers "no pair", the same result as an
                       unconfigured nat46 instance.

diff -ruN a/drv/ppe_drv/tun/ppe_drv_tun.c b/drv/ppe_drv/tun/ppe_drv_tun.c
--- a/drv/ppe_drv/tun/ppe_drv_tun.c
+++ b/drv/ppe_drv/tun/ppe_drv_tun.c
@@ -32,6 +32,29 @@
 
 #include <ppe_drv_sc.h>
 
+/*
+ * QSDK 14.x builds against its own nat46 (2022-09-19), which exports
+ * xlate_4_to_6() / xlate_6_to_4() for the MAP-T data path.  OpenWrt
+ * 25.12 ships nat46 2025-04-23, whose translation API no longer exists
+ * (the module exports nothing).  MAP-T is not part of this port: the
+ * dev_is_mapt() check is a false shim and the MAP-T client
+ * (qca-nss-ppe-mapt) is not built, so no flow can reach these lookups.
+ * Answering "no translation pair" is the same answer an unconfigured
+ * nat46 instance gives, and keeps the failure path intact.  If MAP-T
+ * support is added later, QSDK's nat46 must be used instead.
+ */
+static inline int xlate_4_to_6(struct net_device *dev, struct iphdr *hdr4,
+		uint16_t sport, uint16_t dport, void *v6saddr, void *v6daddr)
+{
+	return 0;
+}
+
+static inline int xlate_6_to_4(struct net_device *dev, struct ipv6hdr *ip6h,
+		uint16_t proto, __u32 *pv4saddr, __u32 *pv4daddr)
+{
+	return 0;
+}
+
 static bool ppe_drv_tun_configure_internal(uint16_t port_num, struct ppe_drv_tun_cmn_ctx *pth, void *add_cb, void *del_cb);
 
 /*
@@ -425,7 +448,7 @@
