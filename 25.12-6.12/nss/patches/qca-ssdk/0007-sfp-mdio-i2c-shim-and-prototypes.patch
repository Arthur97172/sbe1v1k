--- a/src/hsl/phy/sfp_phy.c
+++ b/src/hsl/phy/sfp_phy.c
@@ -24,6 +24,20 @@
 #include "hppe_uniphy.h"
 #include "hsl_port_prop.h"
 #include <linux/mdio/mdio-i2c.h>
+
+#ifndef MIDO_I2C_QCOM
+/*
+ * QSDK-only MDIO-over-I2C bus ABI.  The vendor kernel's mdio-i2c driver
+ * (patches 0643/0934) stores this struct in mii_bus->priv and flags
+ * itself with MIDO_I2C_QCOM.  Mainline 6.12 has neither; the i2c branch
+ * below is only reachable with that driver, and the SBE1V1K board DTS
+ * has no mdio-i2c node, so this definition exists only to compile.
+ */
+struct qcom_mdio_i2c_data {
+	struct i2c_adapter *i2c;
+};
+#endif
+
 #include <linux/i2c.h>
 #include <linux/phylink.h>
 #include <linux/sfp.h>
