+/*
+ * Mainline removed the DSA notifier API (DSA_NOTIFIER_PORT_LINK,
+ * struct dsa_notifier_link, register_dsa_blocking_notifier) in favour of
+ * plain netdevice events on the user port.  Replace it with a netdevice
+ * notifier filtered to DSA user devices; netif_carrier_ok() replaces
+ * info->link.
+ */
 static int ssdk_dsa_event_nb(struct notifier_block *unused,
 		unsigned long event, void *ptr)
 {
-	switch (event) {
-		case DSA_NOTIFIER_PORT_LINK:
-			struct dsa_notifier_link *info = (struct dsa_notifier_link *)ptr;
+	struct net_device *dev;
 
-			SSDK_DEBUG("%s, link: %d.\n", info->info.dev->name, info->link);
-			return ssdk_dsa_event_link_change(info->info.dev, info->link);
+	if (event != NETDEV_CHANGE)
+		return NOTIFY_DONE;
 
-		default:
-			SSDK_INFO("DSA event %lu is not supported\n", event);
-	}
+	dev = netdev_notifier_info_to_dev(ptr);
+	if (!dsa_user_dev_check(dev))
+		return NOTIFY_DONE;
 
-	return NOTIFY_DONE;
+	return ssdk_dsa_event_link_change(dev, netif_carrier_ok(dev));
 }
 
 static struct notifier_block ssdk_dsa_notifier_nb = {
@@ -1859,12 +1865,14 @@
