+			      "nss-mem-noc-nssnoc-clk", "nss-tbu-clk", "nss-ts-clk",
+			      "nss-nsscc-clk", "nss-nsscfg-clk", "nss-nsscnoc-atb-clk",
+			      "nss-nssnoc-mem-noc-1-clk", "nss-nssnoc-memnoc-clk", "nss-nssnoc-nsscc-clk",
